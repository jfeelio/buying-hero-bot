# REsimpli
RESIMPLI_API_KEY=your_resimpli_api_key_here

# Twilio WhatsApp
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Sandbox number (for testing): whatsapp:+14155238886
# Production: whatsapp:+1XXXXXXXXXX (your approved Twilio number)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Comma-separated team phone numbers (include country code, no spaces)
TEAM_WHATSAPP_NUMBERS=+13055551234,+13055555678,+13055559012,+13055553456

# Optional: security token appended to webhook URL
WEBHOOK_SECRET=
